---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2);

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}

const services = [
  {
    num: '01',
    title: 'Done-for-you automation',
    desc: 'I map your workflows and build the automations. You describe the problem; I handle the rest using n8n, AI agents, and whatever tools fit.',
  },
  {
    num: '02',
    title: 'Consulting',
    desc: 'A focused session to find your biggest time leaks and build a plan to fix them.',
  },
  {
    num: '03',
    title: 'DIY guides & newsletter',
    desc: 'Free walkthroughs for agents who want to learn and build their own automations.',
  },
];
---

<Base
  title="Nadtoka AI — Less screen. More life."
  description="I help real estate agents stop living in their CRM and start living their lives, using AI automation."
>
  <section class="fade-up">
    <span class="text-label">Austin, TX — AI Automation</span>
    <h1 class="text-hero" style="margin-top: 12px;">Less screen.<br />More life.</h1>
  </section>

  <hr class="rule-strong" />

  <div class="columns">
    <div class="fade-up" data-delay="1">
      <p class="text-lede">
        I help real estate agents stop living in their CRM and start living their lives.
      </p>
      <p class="text-body" style="margin-top: 20px;">
        From truck driver to trucking company owner — through car sales, insurance, a manicure
        studio, and a painting company — 10+ years of building businesses taught me one thing:
        systems beat effort every time. Now I use AI to build those systems faster than ever.
      </p>

      <hr class="rule" />

      <span class="text-label">Services</span>
      <div style="margin-top: 16px;">
        {services.map((service) => (
          <div class="service">
            <span class="service-num">{service.num}</span>
            <span class="service-title">{service.title}</span>
            <p class="service-desc">{service.desc}</p>
          </div>
        ))}
      </div>
    </div>

    <aside class="fade-up" data-delay="2">
      <span class="text-label">Recent writing</span>
      <div style="margin-top: 12px;">
        {posts.map((post) => (
          <div class="post-row">
            <a href={`/blog/${post.id}/`}>
              <span class="post-date">{formatDate(post.data.date)}</span>
              <h3 class="post-hed">{post.data.title}</h3>
              <p class="post-dek">{post.data.dek}</p>
            </a>
          </div>
        ))}
      </div>

      <div class="cta-bar">
        <span class="cta-text">Guides and automations, free weekly.</span>
        <a href="/contact" class="cta-link">Subscribe →</a>
      </div>

      <div class="tags">
        <span class="tag">Newsletter</span>
        <span class="tag">n8n</span>
        <span class="tag">AI Agents</span>
        <span class="tag">Real Estate</span>
      </div>
    </aside>
  </div>
</Base>
