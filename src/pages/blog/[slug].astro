---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}
---

<Base title={`${post.data.title} — Nadtoka AI`} description={post.data.dek}>
  <article class="fade-up">
    <span class="text-label" style="margin-bottom: 12px;">{formatDate(post.data.date)}</span>
    <h1 class="text-h2" style="font-size: 36px;">{post.data.title}</h1>
    <p class="text-lede" style="margin-top: 12px;">{post.data.dek}</p>
    <hr class="rule" />
    <div class="prose text-body">
      <Content />
    </div>
    <hr class="rule" />
    <p><a href="/blog" class="text-nav">← Back to writing</a></p>
  </article>
</Base>
